# syntax=docker/dockerfile:1
#
# QLever + tegmentum wf:call.
#
# Extends the upstream QLever Dockerfile with:
#   * libcurl (for wf:call HTTP resolution)
#   * bytecodealliance wasmtime C API prebuilt (linked into sparqlExpressions)
#   * -DQLEVER_ENABLE_WF=ON at cmake time
#   * RUN_TESTS=false so we ship a build without waiting on the full suite
#
# Build (arm64, on Apple Silicon under Colima):
#   DOCKER_BUILDKIT=0 docker build --platform linux/arm64 \
#       -f Dockerfile.wf -t qlever-wf:0.1.0 .

FROM ubuntu:24.04 AS base
LABEL maintainer="tegmentum"

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV LC_CTYPE=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

# --- builder stage -----------------------------------------------------------
FROM base AS builder
ENV DEBIAN_FRONTEND=noninteractive

# The ports.ubuntu.com arm64 mirror is regularly slow/timeout-prone from
# behind Colima. Retry each apt-get step a handful of times; better a
# 3-minute cold cache than a cache-invalidating "just re-run docker build".
RUN for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y wget xz-utils && break; \
        echo "apt attempt $i failed, sleeping"; sleep 15; \
    done
RUN wget https://apt.kitware.com/kitware-archive.sh \
    && chmod +x kitware-archive.sh && ./kitware-archive.sh
RUN for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            build-essential cmake libicu-dev tzdata pkg-config uuid-runtime uuid-dev \
            git libjemalloc-dev ninja-build libzstd-dev libssl-dev \
            libboost1.83-dev libboost-program-options1.83-dev libboost-iostreams1.83-dev \
            libboost-url1.83-dev libboost-container1.83-dev \
            libcurl4-openssl-dev && break; \
        echo "apt attempt $i failed, sleeping"; sleep 15; \
    done

# wasmtime C API prebuilt. v27.0.0 matches the header set the wf:call
# glue was written against. Layout: include/wasm.h, include/wasmtime.h,
# include/wasmtime/*.h; lib/libwasmtime.so.
ARG WASMTIME_VER=27.0.0
RUN wget -qO /tmp/wt.tar.xz \
      https://github.com/bytecodealliance/wasmtime/releases/download/v${WASMTIME_VER}/wasmtime-v${WASMTIME_VER}-aarch64-linux-c-api.tar.xz \
    && tar -C /tmp -xf /tmp/wt.tar.xz \
    && cp -r /tmp/wasmtime-v${WASMTIME_VER}-aarch64-linux-c-api/include/* /usr/local/include/ \
    && cp /tmp/wasmtime-v${WASMTIME_VER}-aarch64-linux-c-api/lib/libwasmtime.so /usr/local/lib/ \
    && ldconfig \
    && rm -rf /tmp/wt.tar.xz /tmp/wasmtime-v${WASMTIME_VER}-aarch64-linux-c-api

COPY src /qlever/src/
COPY test /qlever/test/
COPY e2e /qlever/e2e/
COPY benchmark /qlever/benchmark/
COPY .git /qlever/.git/
COPY CMakeLists.txt /qlever/
COPY CompilationInfo.cmake /qlever/
COPY GitVersion.cmake /qlever/

WORKDIR /qlever/build/
RUN cmake -DCMAKE_BUILD_TYPE=Release -DLOGLEVEL=INFO -DUSE_PARALLEL=true \
          -D_NO_TIMING_TESTS=ON -DCOMPILER_SUPPORTS_MARCH_NATIVE=FALSE \
          -DQLEVER_ENABLE_WF=ON \
          -GNinja ..
# Constrain parallelism — the QLever PCH + template-heavy translation units
# each need >1 GB. Under Colima's default 2 GB VM allocation on a Mac host,
# the OOM killer takes cc1plus at higher -j values. `-j 2` is a defensive
# floor; adjust upward if you're building on a fat host.
RUN cmake --build . --target qlever-index qlever-server -- -j 2

# --- runtime stage -----------------------------------------------------------
FROM base AS runtime
WORKDIR /qlever
ENV DEBIAN_FRONTEND=noninteractive

RUN for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends \
            wget python3-yaml unzip curl bzip2 pkg-config libicu74 python3-icu \
            libgomp1 uuid-runtime make lbzip2 libjemalloc2 libzstd1 \
            libboost-program-options1.83.0 libboost-iostreams1.83.0 libboost-url1.83.0 \
            libcurl4 pipx bash-completion vim sudo && break; \
        echo "apt attempt $i failed, sleeping"; sleep 15; \
    done && rm -rf /var/lib/apt/lists/*

# Ship libwasmtime.so from the builder so the qlever-server binary can
# find it at runtime. The C API tarball ships a single shared object.
COPY --from=builder /usr/local/lib/libwasmtime.so /usr/local/lib/
RUN ldconfig

RUN groupadd -r qlever && useradd --no-log-init -d /qlever -r -g qlever qlever \
    && chown qlever:qlever /qlever \
    && echo "qlever ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

ENV QLEVER_PROFILE=/etc/profile.d/qlever.sh
RUN echo "eval \"\$(register-python-argcomplete qlever)\"" >> $QLEVER_PROFILE \
    && echo "export QLEVER_ARGCOMPLETE_ENABLED=1 && export QLEVER_IS_RUNNING_IN_CONTAINER=1" >> $QLEVER_PROFILE \
    && echo "PATH=/qlever:/qlever/.local/bin:\$PATH && PS1=\"\\u@docker:\\W\\$ \"" >> $QLEVER_PROFILE \
    && cp $QLEVER_PROFILE /qlever/.bashrc

USER qlever
ENV PATH=/qlever:/qlever/.local/bin:$PATH
RUN pipx install qlever
ENV QLEVER_ARGCOMPLETE_ENABLED=1
ENV QLEVER_IS_RUNNING_IN_CONTAINER=1

COPY --from=builder /qlever/build/qlever-* /qlever/
# Upstream ships benchmark/main binaries (*Main); our cmake target list is
# `qlever-index qlever-server` only, so *Main artifacts don't exist. Drop
# the COPY rather than adding a placeholder that would need cleanup later.
COPY --from=builder /qlever/e2e/* /qlever/e2e/
# `--chmod` on COPY is a BuildKit-only feature; the legacy builder used
# here (buildx is unavailable under this Colima's daemon-driver mismatch)
# rejects it. Chmod must happen while we're still root — after `USER qlever`
# below it fails with EPERM — so drop back to root for this one step.
USER root
COPY docker-entrypoint.sh /qlever/
RUN chmod 755 /qlever/docker-entrypoint.sh
USER qlever

ENTRYPOINT ["/qlever/docker-entrypoint.sh"]
